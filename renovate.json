{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": [
        "^BAIKAL_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sabre-io/Baikal"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDepNames": ["sabre-io/Baikal"],
      "postUpgradeTasks": {
        "commands": ["sed -i 's/^BUILD_VERSION=.*/BUILD_VERSION=0/' versions.env"],
        "fileFilters": ["versions.env"],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["dockerfile"],
      "postUpgradeTasks": {
        "commands": ["sed -i -E 's/^BUILD_VERSION=([0-9]+)/echo BUILD_VERSION=$((\\1+1))/e' versions.env"],
        "fileFilters": ["versions.env"],
        "executionMode": "branch"
      }
    }
  ]
}
